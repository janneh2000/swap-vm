-    uint256 yieldDuration;
-    /** @notice Additional data buffer for future extensibility and protocol upgrades */
-    bytes additionalBuffer;
-}
-
-/**
- * @title stakingStruct
- * @notice Data structure tracking token staking details for protocol participants
